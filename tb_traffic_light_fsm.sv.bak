'timescale 1ns / 1ps

module tb_traffic_light();

	logic clk;
	logic reset;
	logic TAORB;
	logic [2:0] LA;
	logic [2:0] LB;
	
	traffic_light_fsm uut (
		.clk(clk),
		.reset(reset),
		.TAORB(TAORB),
		.LA(LA),
		.LB(LB),
	);
	
	always #5 clk= ~clk;
	
	initial begin
	
		clk=0;
		reset=1;
		TAORB= 1;
		
		#15 reset 0;
		
		#20;
		
		TAORB = 0;
		
		#100;
		
		TAORB =1;
		
		#100;
		
		$finish;
	end
	
endmodule